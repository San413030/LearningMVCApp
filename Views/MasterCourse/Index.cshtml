@model IEnumerable<LearningPlatform.Models.MasterCourse>


@if(TempData["msg"] != null)
{
    <div class="alert alert-success">
        @TempData["msg"]
    </div>
}


<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel"> Create Master Course</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
               

                <form asp-action="Create" method="post" enctype="multipart/form-data">

                    <label>Course Name</label>
                    <input name="MasterCourseName" type="text" class="form-control" />

                    <br /><br />

                    <label>Thumbnail</label>
                    <input type="file" name="ThumbnailFile" class="form-control" />

                    <br /><br />

                    <label>Status</label>
                    <select name="Status" class="form-control">
                        <option value="">Select Status</option>
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>

                    <br /><br />


                    <button type="submit" class="btn btn-primary">Save</button>

                </form>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


<button type="button"
        id="btnAdd"
        class="btn btn-primary mt-5 mb-5"
        data-bs-toggle="modal"
        data-bs-target="#exampleModal">
    Add
</button>

<h2>Master Course List</h2>

<table id="masterCourseTable" class="table table-bordered table-striped">

    <thead>
        <tr>
            <th>ID</th>
            <th>Course Name</th>
            <th>Thumbnail</th>
            <th>Status</th>
            <th>Created At</th>
            <th>Created By</th>
            <th> Action </th>
        </tr>
    </thead>

    <tbody>

        @foreach (var course in Model)
        {
            <tr>
                <td>@course.MasterCourseId</td>
                <td>@course.MasterCourseName</td>
                <td>
                    <img src="@course.Thumbnail"
                         width="80"
                         height="60" 
                         style="object-fit: cover;"/>
                </td>
                <td>
                    @if (course.Status == "Active")
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactive</span>
                    }
                </td>
                <td>@course.CreatedAt</td>
                <td>@course.CreatedBy</td>
                <td>
                    <button type="button"
                            class="btn btn-primary btn-sm"
                            data-bs-toggle="modal"
                            data-bs-target="#Edit"
                            onclick="editCourse(
                                      '@course.MasterCourseId',
                                      '@course.MasterCourseName',
                                      '@course.Thumbnail',
                                      '@course.Status'
            )">
                        <i class="fas fa-edit"></i>
                    </button>

                    <a asp-action="Delete"
                       asp-route-id="@course.MasterCourseId"
                       class="btn btn-danger btn-sm">
                        <i class="fas fa-trash"></i>
                    </a>
                </td>
            </tr>
        }

    </tbody>


</table>


<div class="modal fade" id="Edit" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel">Edit Master Course</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form asp-action="UpdateData" method="post" enctype="multipart/form-data">

                    <input type="hidden"
                           id="editId"
                           name="MasterCourseId" />

                    <label>Course Name</label>
                    <input type="text"
                           id="editName"
                           name="MasterCourseName"
                           class="form-control" />

                    <br /><br />

                    <label>Thumbnail</label>

                    <input type="file"
                           name="ThumbnailFile"
                           class="form-control" />

                    <br />

                    <label>Status</label>
                    <select id="editStatus"
                            name="Status"
                            class="form-control">
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>

                    <br /><br />


                    <button type="submit" class="btn btn-primary">
                        Update
                    </button>


                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                
            </div>
        </div>
    </div>
</div>



@section Scripts
{
    <script>

        function editCourse(id, name,thumbnail, status, createdBy) {

            document.getElementById("editId").value = id;

            document.getElementById("editName").value = name;

            document.getElementById("editStatus").value = status;

        }


        $(document).ready(function () {

            $('#masterCourseTable').DataTable();

        });

    </script>
}
